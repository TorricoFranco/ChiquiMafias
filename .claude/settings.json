{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run lint *)",
      "Bash(npm run build *)",
      "Bash(npm run format *)",
      "Bash(npm run test:unit *)",
      "Bash(npx jest src/*)",
      "Bash(npx jest --listTests *)",
      "Bash(npx prisma generate *)",
      "Bash(npx prisma validate *)",
      "Bash(npx prisma format *)",
      "Bash(npx tsc --noEmit *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch *)",
      "PowerShell(npm run lint *)",
      "PowerShell(npm run build *)",
      "PowerShell(npm run format *)",
      "PowerShell(npm run test:unit *)",
      "PowerShell(npx jest src/*)",
      "PowerShell(npx jest --listTests *)",
      "PowerShell(npx prisma generate *)",
      "PowerShell(npx prisma validate *)",
      "PowerShell(npx prisma format *)",
      "PowerShell(npx tsc --noEmit *)",
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)",
      "PowerShell(git branch *)"
    ],
    "ask": [
      "Bash(npm test *)",
      "Bash(npm run test *)",
      "Bash(npm run test:e2e *)",
      "Bash(npm run test:cov *)",
      "Bash(npx jest test/*)",
      "Bash(npx jest --config *)",
      "Bash(npx prisma db push *)",
      "Bash(npx prisma migrate *)",
      "Bash(docker compose *)",
      "Bash(git push *)",
      "PowerShell(npm test *)",
      "PowerShell(npm run test *)",
      "PowerShell(npm run test:e2e *)",
      "PowerShell(npm run test:cov *)",
      "PowerShell(npx jest test/*)",
      "PowerShell(npx jest --config *)",
      "PowerShell(npx prisma db push *)",
      "PowerShell(npx prisma migrate *)",
      "PowerShell(docker compose *)",
      "PowerShell(git push *)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Read(backup_dev.sql)",
      "Edit(/frontend/**)",
      "Bash(npx prisma migrate reset*)",
      "Bash(npx prisma *--force-reset*)",
      "Bash(docker compose *down -v*)",
      "Bash(docker compose *down --volumes*)",
      "Bash(git push *--force*)",
      "PowerShell(npx prisma migrate reset*)",
      "PowerShell(npx prisma *--force-reset*)",
      "PowerShell(docker compose *down -v*)",
      "PowerShell(docker compose *down --volumes*)",
      "PowerShell(git push *--force*)"
    ]
  }
}
