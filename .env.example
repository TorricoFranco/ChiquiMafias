# ==========================================
# CONFIGURACIÓN DEL SERVIDOR
# ==========================================
PORT=3007
HOST=0.0.0.0

# ==========================================
# DATOS DEPORTIVOS (API-FOOTBALL)
# ==========================================
ID_LEAGUE_ARG=128
API_FOOTBALL_KEY=tu_api_key_de_api_football_aqui

# ==========================================
# CLIENTE / CORS
# ==========================================
NEXT_PUBLIC_API_URL=http://localhost:3007
CLIENT_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# ==========================================
# AUTENTICACIÓN (GOOGLE & JWT)
# ==========================================
GOOGLE_CLIENT_ID=tu_cliente_id.apps.googleusercontent.com

JWT_ACCESS_SECRET=tu_secreto_para_access_token_super_seguro
JWT_REFRESH_SECRET=tu_secreto_para_refresh_token_super_seguro
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# ==========================================
# MERCADO PAGO & SUSCRIPCIONES
# ==========================================
FRONTEND_SUCCESS_URL=subscriptions/success
FRONTEND_FAILURE_URL=subscriptions/failed
FRONTEND_PENDING_URL=subscriptions/pending

MERCADO_PAGO_API_URL=https://api.mercadopago.com
MERCADO_PAGO_ACCESS_TOKEN=APP_USR-tu_access_token_de_mercado_pago
MERCADO_PAGO_RECEIVER_ID=tu_receiver_id_opcional
MERCADO_PAGO_WEBHOOK_URL=https://tu-url-de-ngrok.ngrok-free.dev/webhook/mercado-pago
MERCADO_PAGO_WEBHOOK_SECRET=tu_secreto_de_webhook_de_mercado_pago

# ==========================================
# MEDIA (CLOUDINARY)
# ==========================================
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_cloudinary_api_key
CLOUDINARY_API_SECRET=tu_cloudinary_api_secret

# ==========================================
# EMAILS (RESEND)
# ==========================================
RESEND_API_KEY=re_tu_api_key_de_resend

# ==========================================
# INTEGRACIÓN CON DISCORD
# ==========================================
DISCORD_BOT_URL=http://discord_bot:3001/api
DISCORD_INTERNAL_SECRET=tu_secreto_interno_compartido_entre_backend_y_bot
DISCORD_BOT_TOKEN=tu_token_del_bot_de_discord

# ==========================================
# NGROK (TÚNELES LOCALES)
# ==========================================
CHOKIDAR_USEPOLLING=true
NGROK_AUTHTOKEN=tu_auth_token_de_ngrok

# ==========================================
# CACHÉ Y ESTADOS (REDIS)
# ==========================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=tu_password_segura_de_redis

# ==========================================
# BASE DE DATOS (POSTGRESQL) 
# ==========================================
DATABASE_URL=postgresql://usuario:password_segura@postgres:5432/football_db
POSTGRES_USER=usuario
POSTGRES_PASSWORD=password_segura
POSTGRES_DB=football_db