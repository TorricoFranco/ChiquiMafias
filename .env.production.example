# ==========================================================================
# PRODUCCIÓN — plantilla del .env del servidor
#
# En el VPS: `cp .env.production.example .env`, completá los valores y dejá permisos
# restringidos (`chmod 600 .env`). Nunca lo subas a git: el .env real está en .gitignore.
# Ver docs/DEPLOY.md.
#
# Generar secretos (no reuses los de desarrollo):
#   openssl rand -base64 48      # JWT_ACCESS_SECRET, JWT_REFRESH_SECRET, DISCORD_INTERNAL_SECRET
#   openssl rand -hex 24         # POSTGRES_PASSWORD, REDIS_PASSWORD (hex: no necesita escapes en la URL)
#
# Valores que el docker-compose.yml fija solo y que NO hace falta poner acá:
# NODE_ENV, PORT, HOST, ENABLE_DEV_TOOLS, REDIS_HOST y REDIS_PORT.
# ==========================================================================

# --------------------------------------------------------------------------
# Dominios (los usa Caddy; el certificado HTTPS se pide solo)
# Los registros DNS A de APP_DOMAIN, www.APP_DOMAIN y API_DOMAIN tienen que apuntar al VPS.
# --------------------------------------------------------------------------
APP_DOMAIN=chiquimafias.com
API_DOMAIN=api.chiquimafias.com

# --------------------------------------------------------------------------
# URLs. Tienen que coincidir EXACTO con el origen del navegador (https, sin www).
# CLIENT_URL es el único origen que acepta el CORS de la API y de los sockets.
# --------------------------------------------------------------------------
CLIENT_URL=https://chiquimafias.com
FRONTEND_URL=https://chiquimafias.com

# El frontend hornea esto al compilar: si cambia, hay que reconstruir (`docker compose up -d --build`).
API_BACKEND_URL=https://api.chiquimafias.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=CAMBIAR_cliente.apps.googleusercontent.com
NEXT_PUBLIC_ARGENTINA_LEAGUE_ID=128

# --------------------------------------------------------------------------
# Base de datos (PostgreSQL). El host es el nombre del servicio del compose: `postgres`.
# DATABASE_URL tiene que usar el mismo usuario, contraseña y base que las tres de abajo.
# --------------------------------------------------------------------------
POSTGRES_USER=chiquimafias
POSTGRES_PASSWORD=CAMBIAR_hex_de_48_caracteres
POSTGRES_DB=football_db
DATABASE_URL=postgresql://chiquimafias:CAMBIAR_hex_de_48_caracteres@postgres:5432/football_db

# --------------------------------------------------------------------------
# Redis (guarda saldos y apuestas en curso: nunca lo expongas)
# --------------------------------------------------------------------------
REDIS_PASSWORD=CAMBIAR_hex_de_48_caracteres

# --------------------------------------------------------------------------
# Autenticación
# --------------------------------------------------------------------------
# En la consola de Google Cloud, agregá https://chiquimafias.com a los orígenes autorizados.
GOOGLE_CLIENT_ID=CAMBIAR_cliente.apps.googleusercontent.com
JWT_ACCESS_SECRET=CAMBIAR_base64_de_64_caracteres
JWT_REFRESH_SECRET=CAMBIAR_base64_de_64_caracteres
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# --------------------------------------------------------------------------
# Datos deportivos
# --------------------------------------------------------------------------
ID_LEAGUE_ARG=128
API_FOOTBALL_KEY=CAMBIAR_api_key_de_api_football

# --------------------------------------------------------------------------
# Mercado Pago — credenciales de PRODUCCIÓN (APP_USR-...), no las de prueba
# La URL del webhook también se carga en el panel de Mercado Pago, junto con su secreto de firma.
# --------------------------------------------------------------------------
MERCADO_PAGO_API_URL=https://api.mercadopago.com
MERCADO_PAGO_ACCESS_TOKEN=APP_USR-CAMBIAR
MERCADO_PAGO_RECEIVER_ID=
MERCADO_PAGO_WEBHOOK_URL=https://api.chiquimafias.com/webhook/mercado-pago
MERCADO_PAGO_WEBHOOK_SECRET=CAMBIAR_secreto_de_firma_del_panel_de_mercado_pago
# Rutas del frontend a las que vuelve el usuario después de pagar (relativas, sin dominio).
FRONTEND_SUCCESS_URL=subscriptions/success
FRONTEND_FAILURE_URL=subscriptions/failed
FRONTEND_PENDING_URL=subscriptions/pending

# --------------------------------------------------------------------------
# Servicios externos
# --------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=CAMBIAR
CLOUDINARY_API_KEY=CAMBIAR
CLOUDINARY_API_SECRET=CAMBIAR
RESEND_API_KEY=re_CAMBIAR

# --------------------------------------------------------------------------
# Bot de Discord
# DISCORD_BOT_URL termina en /api (el bot monta ahí sus rutas): sin eso, los reportes y tickets
# no llegan a Discord y el backend solo lo registra en el log.
# DISCORD_INTERNAL_SECRET es el mismo valor para el backend y el bot.
# --------------------------------------------------------------------------
DISCORD_BOT_URL=http://discord_bot:3001/api
DISCORD_INTERNAL_SECRET=CAMBIAR_base64_de_64_caracteres
DISCORD_BOT_TOKEN=CAMBIAR
DISCORD_GUILD_ID=CAMBIAR
DISCORD_TICKETS_CHANNEL_ID=CAMBIAR
DISCORD_MODERATION_CHANNEL_ID=CAMBIAR
